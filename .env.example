# Pass settings through the shell or hosting platform.
# To load this file locally after building, copy it to .env and run
# node --env-file=.env scripts/start.mjs
PORT=3000
LOG_LEVEL=info
BUILD_REVISION=development

# Defaults to the repository's data directory. Use a persistent writable
# directory in production. Supply a disposable copy for migration rehearsals.
# DATA_DIR=/app/data

# Optional comma-separated origins for a separately hosted client.
# ALLOWED_ORIGINS=https://tunes.example.com

# Set either flag to false to pause new starts for that pilot feature.
TUNES_DINNER_ENABLED=true
TUNES_LICENSED_ENABLED=true

# Optional automatic pack manifest and clip directory. A changed manifest
# loads on process restart. Supply only recordings cleared for this deployment.
# TUNES_LICENSED_MANIFEST=/app/licensed/manifest.json
# TUNES_LICENSED_AUDIO_DIR=/app/licensed/clips

# Apply a country code only when upstream access is restricted accordingly.
# Leave unset to use worldwide tracks exclusively on an unrestricted server.
# TUNES_GEO_FENCED_TERRITORY=HK
