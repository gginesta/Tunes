# Same-origin production and the local Vite proxy work with this unset.
# Set it only when the browser must connect to a separately hosted server.
# VITE_SERVER_URL=https://tunes.example.com

# Optional client build stamp. Docker and CI set it from the release revision.
# VITE_BUILD_REVISION=development

# For a deployment with Spotify game-use permission, enter its public app ID
# and the exact callback registered for this origin. Never set a client secret.
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_REDIRECT_URI=https://your-game.example/callback.html
